# MySQL. En Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:password@host:3306/railway

# Firma de las sesiones (admin y mayoristas). Cadena larga y aleatoria.
JWT_SECRET=

# Secreto para crear el PRIMER admin en /admin. Borrarlo de Railway después.
ADMIN_SETUP_TOKEN=

# Opcional: emails (confirmación de pedido, aprobación mayorista, contacto) con Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: a dónde llegan los avisos internos (por defecto, el email de Settings del panel).
NOTIFY_EMAIL=
# Opcional: URL pública para los links de los emails (ej. https://krunkd.com).
PUBLIC_URL=
